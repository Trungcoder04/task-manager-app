// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement()) @map("Id")
  username  String   @unique @db.VarChar(50) @map("Username")
  password  String   @db.VarChar(255) @map("Password")
  fullName  String   @db.VarChar(100) @map("FullName")
  email     String?  @unique @db.VarChar(100) @map("Email")
  createdAt DateTime @default(now()) @map("CreatedAt")

  ownedProjects  Project[]        @relation("ProjectOwner")
  projectMembers ProjectMember[]
  assignedTasks  Task[]           @relation("TaskAssignee")
  attachments    TaskAttachment[]
  comments       TaskComment[]
  activities     TaskActivity[]

  @@map("Users")
}

model Project {
  id          Int      @id @default(autoincrement()) @map("Id")
  name        String   @db.VarChar(255) @map("Name")
  description String?  @db.Text @map("Description")
  ownerId     Int      @map("OwnerId")
  createdAt   DateTime @default(now()) @map("CreatedAt")

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  tasks   Task[]
  labels  Label[]

  @@map("Projects")
}

model ProjectMember {
  projectId Int      @map("ProjectId")
  userId    Int      @map("UserId")
  role      Int      @default(2) @map("Role") // 1: Admin, 2: Member
  joinedAt  DateTime @default(now()) @map("JoinedAt")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("ProjectMembers")
}

model Task {
  id          Int       @id @default(autoincrement()) @map("Id")
  projectId   Int       @map("ProjectId")
  title       String    @db.VarChar(255) @map("Title")
  description String?   @db.Text @map("Description")
  status      Int       @default(1) @map("Status") // 1: Todo, 2: Doing, 3: Done
  priority    Int       @default(2) @map("Priority") // 1: Low, 2: Medium, 3: High
  dueDate     DateTime? @map("DueDate")
  assigneeId  Int?      @map("AssigneeId")
  orderIndex  Float     @default(0) @map("OrderIndex")
  createdAt   DateTime  @default(now()) @map("CreatedAt")

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  taskLabels  TaskLabel[]
  attachments TaskAttachment[]
  comments    TaskComment[]
  activities  TaskActivity[]

  @@map("Tasks")
}

model Label {
  id        Int     @id @default(autoincrement()) @map("Id")
  projectId Int     @map("ProjectId")
  name      String  @db.VarChar(100) @map("Name")
  colorCode String? @db.VarChar(20) @map("ColorCode")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLabels TaskLabel[]

  @@map("Labels")
}

model TaskLabel {
  taskId  Int @map("TaskId")
  labelId Int @map("LabelId")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("TaskLabels")
}

model TaskAttachment {
  id         Int      @id @default(autoincrement()) @map("Id")
  taskId     Int      @map("TaskId")
  uploaderId Int      @map("UploaderId")
  fileName   String   @db.VarChar(255) @map("FileName")
  fileUrl    String   @db.Text @map("FileUrl")
  uploadedAt DateTime @default(now()) @map("UploadedAt")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@map("TaskAttachments")
}

model TaskComment {
  id        Int      @id @default(autoincrement()) @map("Id")
  taskId    Int      @map("TaskId")
  userId    Int      @map("UserId")
  content   String   @db.Text @map("Content")
  createdAt DateTime @default(now()) @map("CreatedAt")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("TaskComments")
}

model TaskActivity {
  id        Int      @id @default(autoincrement()) @map("Id")
  taskId    Int      @map("TaskId")
  userId    Int      @map("UserId")
  action    String   @db.VarChar(255) @map("Action")
  createdAt DateTime @default(now()) @map("CreatedAt")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("TaskActivities")
}
