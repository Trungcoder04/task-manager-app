// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement()) @map("Id")
  username  String   @unique @db.VarChar(50) @map("Username")
  password  String   @db.VarChar(255) @map("Password")
  fullName  String   @db.VarChar(100) @map("FullName")
  email     String?  @unique @db.VarChar(100) @map("Email")
  status    Int      @default(1) @map("Status") // 1: Active, 2: Locked, 3: Disabled
  role      Int      @default(2) @map("Role") // 1: Admin, 2: User
  createdAt DateTime @default(now()) @map("CreatedAt")
  avatar    String?  @db.Text @map("Avatar")

  ownedProjects       Project[]              @relation("ProjectOwner")
  projectMembers      ProjectMember[]
  assignedTasks       Task[]                 @relation("TaskAssignee")
  assignedByMe        Task[]                 @relation("TaskAssigner")
  createdTasks        Task[]                 @relation("TaskCreator")
  attachments         TaskAttachment[]
  comments            TaskComment[]
  activities          TaskActivity[]
  requestedExtensions TaskExtensionRequest[] @relation("RequestedExtensions")
  reviewedExtensions  TaskExtensionRequest[] @relation("ReviewedExtensions")

  @@map("Users")
}

model Project {
  id          Int      @id @default(autoincrement()) @map("Id")
  name        String   @db.VarChar(255) @map("Name")
  description String?  @db.Text @map("Description")
  ownerId     Int      @map("OwnerId")
  createdAt   DateTime @default(now()) @map("CreatedAt")

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  tasks   Task[]
  labels  Label[]

  @@index([ownerId])
  @@map("Projects")
}

model ProjectMember {
  projectId Int      @map("ProjectId")
  userId    Int      @map("UserId")
  role      Int      @default(3) @map("Role") // 1: OWNER (Chủ dự án), 2: LEAD (Trưởng nhóm), 3: MEMBER (Nhân viên)
  joinedAt  DateTime @default(now()) @map("JoinedAt")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("ProjectMembers")
}

model Task {
  id          Int       @id @default(autoincrement()) @map("Id")
  projectId   Int       @map("ProjectId")
  title       String    @db.VarChar(255) @map("Title")
  description String?   @db.Text @map("Description")
  status      Int       @default(0) @map("Status") // -1: DRAFT, 0: PENDING_APPROVAL, 1: TODO, 2: IN_PROGRESS, 3: IN_REVIEW, 4: DONE, 5: REJECTED
  priority    Int       @default(2) @map("Priority") // 1: LOW, 2: MEDIUM, 3: HIGH
  dueDate     DateTime? @map("DueDate")
  assigneeId  Int?      @map("AssigneeId")
  assignerId  Int?      @map("AssignerId")
  createdById Int?      @map("CreatedById")
  orderIndex  Float     @default(0) @map("OrderIndex")
  createdAt   DateTime  @default(now()) @map("CreatedAt")

  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee          User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigner          User?                  @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: SetNull)
  createdBy         User?                  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  taskLabels        TaskLabel[]
  attachments       TaskAttachment[]
  comments          TaskComment[]
  activities        TaskActivity[]
  extensionRequests TaskExtensionRequest[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([assignerId])
  @@index([createdById])
  @@map("Tasks")
}
model Label {
  id        Int     @id @default(autoincrement()) @map("Id")
  projectId Int     @map("ProjectId")
  name      String  @db.VarChar(100) @map("Name")
  colorCode String? @db.VarChar(20) @map("ColorCode")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLabels TaskLabel[]

  @@index([projectId])
  @@map("Labels")
}

model TaskLabel {
  taskId  Int @map("TaskId")
  labelId Int @map("LabelId")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("TaskLabels")
}

model TaskAttachment {
  id         Int      @id @default(autoincrement()) @map("Id")
  taskId     Int      @map("TaskId")
  uploaderId Int      @map("UploaderId")
  fileName   String   @db.VarChar(255) @map("FileName")
  fileUrl    String   @db.Text @map("FileUrl")
  uploadedAt DateTime @default(now()) @map("UploadedAt")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploaderId])
  @@map("TaskAttachments")
}

model TaskComment {
  id        Int      @id @default(autoincrement()) @map("Id")
  taskId    Int      @map("TaskId")
  userId    Int      @map("UserId")
  content   String   @db.Text @map("Content")
  createdAt DateTime @default(now()) @map("CreatedAt")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("TaskComments")
}

model TaskActivity {
  id        Int      @id @default(autoincrement()) @map("Id")
  taskId    Int      @map("TaskId")
  userId    Int      @map("UserId")
  action    String   @db.VarChar(255) @map("Action")
  createdAt DateTime @default(now()) @map("CreatedAt")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("TaskActivities")
}

model TaskExtensionRequest {
  id            Int       @id @default(autoincrement()) @map("Id")
  taskId        Int       @map("TaskId")
  requestedById Int       @map("RequestedById")
  oldDueDate    DateTime? @map("OldDueDate")
  newDueDate    DateTime  @map("NewDueDate")
  reason        String    @db.Text @map("Reason")
  status        Int       @default(0) @map("Status") // 0: PENDING, 1: APPROVED, 2: REJECTED
  reviewedById  Int?      @map("ReviewedById")
  reviewNote    String?   @db.Text @map("ReviewNote")
  createdAt     DateTime  @default(now()) @map("CreatedAt")
  reviewedAt    DateTime? @map("ReviewedAt")

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestedExtensions", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("ReviewedExtensions", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([requestedById])
  @@index([reviewedById])
  @@map("TaskExtensionRequests")
}
